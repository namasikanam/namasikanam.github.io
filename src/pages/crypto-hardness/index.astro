---
import fs from "node:fs";
import Base from "../../layouts/Base.astro";
import {
  parseMarkdownTable,
  renderCell,
  resolveLink,
  escapeHtml,
} from "../../lib/markdownTable";
import "katex/dist/katex.min.css";

// The human-editable Markdown sources (see crypto-hardness/README.md).
const assumptionsMd = fs.readFileSync("crypto-hardness/data/assumptions.md", "utf-8");
const attemptsMd = fs.readFileSync("crypto-hardness/data/attempts.md", "utf-8");

const assumptions = parseMarkdownTable(assumptionsMd);
if (!assumptions) throw new Error("no table found in data/assumptions.md");
const attempts = parseMarkdownTable(attemptsMd);
if (!attempts) throw new Error("no table found in data/attempts.md");

// --- assumptions: build a lookup from assumption name -> its page, for auto-linking attempts.
const nameCol = assumptions.header.findIndex((h) => /name/i.test(h));
const fileCol = assumptions.header.findIndex((h) => /file/i.test(h));
const catCol = assumptions.header.findIndex((h) => /categ/i.test(h));

const nameToFile: Record<string, string> = {};
for (const cells of assumptions.body) {
  const m = (cells[fileCol] || "").match(/\(([^)]+\.md[^)]*)\)/);
  if (nameCol < 0 || !m) continue;
  const name = cells[nameCol]!;
  const keys = new Set([name.toLowerCase()]);
  // also index the part before " (" and any parenthetical abbreviations,
  // e.g. "Learning With Errors (LWE)" -> "learning with errors", "lwe"
  keys.add(name.replace(/\s*\(.*$/, "").toLowerCase().trim());
  (name.match(/\(([^)]+)\)/g) || []).forEach((p) =>
    p.replace(/[()]/g, "").split(/[\/,]/).forEach((a) => keys.add(a.toLowerCase().trim())),
  );
  keys.forEach((k) => {
    if (k) nameToFile[k] = resolveLink(m[1]!);
  });
}

const assumptionRows = assumptions.body.map((cells) =>
  cells.map((c, i) => (i === catCol ? `<span class="cat">${escapeHtml(c)}</span>` : renderCell(c))),
);

// --- proof attempts: auto-link assumption names, color-code results.
const attNameCol = attempts.header.findIndex((h) => /assumption|name/i.test(h));
const attResCol = attempts.header.findIndex((h) => /result/i.test(h));

// Categorize a result string into a tag class for coloring.
function resultClass(txt: string): string {
  const t = txt.toLowerCase();
  if (t.includes("example")) return "tag-example";
  if (t.includes("broken") || t.includes("solved")) return "tag-broken";
  if (
    t.includes("novel") ||
    t.includes("partial") ||
    (t.includes("progress") && !t.includes("no-progress") && !t.includes("no progress"))
  )
    return "tag-progress";
  if (t.includes("no-progress") || t.includes("no progress") || t.includes("fail")) return "tag-none";
  return "";
}

const attemptRows = attempts.body.map((cells) =>
  cells.map((c, i) => {
    if (i === attNameCol) {
      const f = nameToFile[c.toLowerCase().trim()];
      const inner = renderCell(c);
      return f ? `<a href="${f}">${inner}</a>` : inner;
    }
    if (i === attResCol) return `<span class="tag ${resultClass(c)}">${renderCell(c)}</span>`;
    return renderCell(c);
  }),
);
---

<Base title="Cryptographic Hardness Assumptions — namasikanam">
  <a class="backlink" href="/">← Xingyu Xie (namasikanam)</a>

  <h1 class="name"><a href="#">Cryptographic Hardness Assumptions</a></h1>

  <div class="intro">
    An open-sourced log of attempts to resolve the hardness assumptions that modern
    cryptography relies on -- attempts to break them or to prove them, by AI agents or collaboration with AI agents.
    Below the table is the assumptions themselves; each row links to a page
    containing mathematical statement (currently generated by AI).
    <br /><br />
    Both tables are plain Markdown files that anyone can edit:
    <code>data/attempts.md</code> and <code>data/assumptions.md</code>.
    The site rebuilds automatically when a pull request is merged.
  </div>

  <h2 class="section" id="attempts">Proof Attempts</h2>
  <div class="intro" style="margin-bottom:10px;">
    To add yours, append one row to <code>data/attempts.md</code> and open a pull request.
    The <strong>Assumption</strong> column should match a assumption in the catalogue below;
    <strong>Operator</strong> is the person who steered the AI (use "—" for fully autonomous runs).
  </div>
  <div class="toolbar">
    <input type="search" id="filter-att" placeholder="Filter attempts (assumption, model, result…)" aria-label="Filter attempts" />
    <span class="rowcount" id="count-att"></span>
    <a class="btn" href="https://github.com/namasikanam/namasikanam.github.io/edit/main/crypto-hardness/data/attempts.md" target="_blank" rel="noopener">＋ Add an attempt</a>
  </div>
  <div class="table-wrap">
    <table class="data" id="table-att" data-filter="filter-att" data-count="count-att">
      <thead>
        <tr>{attempts.header.map((h, i) => <th data-col={i}>{h}<span class="arrow"></span></th>)}</tr>
      </thead>
      <tbody>
        {attemptRows.map((cells) => (
          <tr>{cells.map((html) => <td set:html={html} />)}</tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section" id="assumptions">The Assumptions</h2>
  <div class="toolbar">
    <input type="search" id="filter-conj" placeholder="Filter assumptions (name, category, note…)" aria-label="Filter assumptions" />
    <span class="rowcount" id="count-conj"></span>
    <a class="btn" href="https://github.com/namasikanam/namasikanam.github.io/blob/main/crypto-hardness/data/assumptions.md" target="_blank" rel="noopener">View / edit source</a>
  </div>
  <div class="table-wrap">
    <table class="data" id="table-conj" data-filter="filter-conj" data-count="count-conj">
      <thead>
        <tr>{assumptions.header.map((h, i) => <th data-col={i}>{h}<span class="arrow"></span></th>)}</tr>
      </thead>
      <tbody>
        {assumptionRows.map((cells) => (
          <tr>{cells.map((html) => <td set:html={html} />)}</tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="intro" style="margin-bottom:10px;">
    <strong>Importance</strong> and <strong>Difficulty</strong> each start with a
    <strong>1–10 score</strong> — click the column header to rank by it.
    <br />
    <strong>Importance</strong> (how much rests on the assumption):
    10 = underpins ubiquitous deployed infrastructure; 7–9 = major deployments or a
    foundational literature; 4–6 = significant literature / niche deployment; 1–3 = historic or specialized.
    <br />
    <strong>Difficulty</strong> (how hard the problem is, given the best known attacks;
    <strong>C:</strong> classical, <strong>Q:</strong> quantum; "exp"/"subexp"/"poly" = exponential /
    subexponential / polynomial time, where "poly" means the assumption is <em>false</em> in that model,
    e.g. "Q: poly (Shor)" = broken by large-scale quantum computers):
    10 = no approach known at all; 8–9 = only exponential attacks, classical <em>and</em> quantum;
    6–7 = exponential classically but quantum-broken (or minor caveats); 4–5 = subexponential
    classical attacks or degraded regimes; 1–3 = fragile outside carefully chosen parameters.
    <br />
    These scores are currently generated by AI. Pull request for updating scores are genuiely welcome.
  </div>
</Base>

<style is:global>
  /* ---- page-specific extensions of the Dune theme ---- */
  .container { max-width: 1100px; }

  .backlink { font-size: 0.9em; margin-bottom: 20px; display: inline-block; }

  .intro { color: #a89a82; font-size: 0.92em; margin-bottom: 24px; }
  .intro code { color: #e8dcc4; }

  .toolbar {
    display: flex; flex-wrap: wrap; gap: 10px; align-items: center;
    margin: 14px 0 10px 0;
  }
  .toolbar input[type="search"] {
    flex: 1 1 220px; min-width: 180px;
    background: #1a1915; color: #e8dcc4;
    border: 1px solid #3d3428; padding: 7px 10px;
    font-family: inherit; font-size: 0.9em;
  }
  .toolbar input[type="search"]:focus { outline: none; border-color: #c9a227; }
  .rowcount { color: #a89a82; font-size: 0.85em; }

  .btn {
    display: inline-block; padding: 7px 12px;
    border: 1px solid #c9a227; color: #c9a227;
    text-decoration: none; font-size: 0.9em; white-space: nowrap;
  }
  .btn:hover { background: #c9a227; color: #0f0e0c; text-decoration: none; }

  .table-wrap { overflow-x: auto; border: 1px solid #3d3428; margin-bottom: 10px; }
  table.data { border-collapse: collapse; width: 100%; font-size: 0.82em; }
  table.data th, table.data td {
    border: 1px solid #3d3428; padding: 7px 9px;
    text-align: left; vertical-align: top;
  }
  table.data thead th {
    position: sticky; top: 0; z-index: 2;
    background: #1a1915; color: #c9a227;
    cursor: pointer; white-space: nowrap; user-select: none;
  }
  table.data thead th:hover { color: #e8b923; }
  table.data thead th .arrow { color: #d4883a; font-size: 0.85em; }
  table.data tbody tr:nth-child(even) { background: rgba(201, 162, 39, 0.05); }
  table.data tbody tr:hover { background: rgba(201, 162, 39, 0.12); }
  table.data td a { color: #d4a574; }
  table.data td a:hover { color: #e8c49a; }
  table.data code { color: #e8dcc4; background: rgba(255,255,255,0.06); padding: 0 3px; }

  /* category chip in the assumptions table */
  .cat {
    display: inline-block; font-size: 0.85em; color: #d4883a;
    white-space: nowrap;
  }

  /* result tags in the attacks table */
  .tag { font-weight: bold; }
  .tag-broken { color: #ff5c5c; }
  .tag-progress { color: #c9a227; }
  .tag-none { color: #888; }
  .tag-example { color: #6a6252; font-style: italic; }

  .katex { font-size: 1em; }
  h2.section { margin-top: 40px; }
</style>

<script>
  // Client-side filtering + click-to-sort over the server-rendered tables.
  function enhanceTable(tableEl: HTMLTableElement) {
    const filterEl = document.getElementById(tableEl.dataset.filter!) as HTMLInputElement;
    const countEl = document.getElementById(tableEl.dataset.count!)!;
    const thead = tableEl.tHead!;
    const tbody = tableEl.tBodies[0]!;
    const rows = Array.from(tbody.rows);
    const texts = rows.map((r) =>
      Array.from(r.cells).map((c) => (c.textContent || "").trim()),
    );
    const total = rows.length;

    let sortCol = -1;
    let sortDir = 1;
    const order = rows.map((_, i) => i);

    function draw() {
      const q = (filterEl.value || "").toLowerCase().trim();
      let shown = 0;
      tbody.replaceChildren(
        ...order
          .filter((idx) => {
            const keep = !q || texts[idx]!.join(" ").toLowerCase().includes(q);
            if (keep) shown++;
            return keep;
          })
          .map((idx) => rows[idx]!),
      );
      countEl.textContent = shown + " / " + total + " rows";
      thead.querySelectorAll("th").forEach((th, i) => {
        th.querySelector(".arrow")!.textContent =
          i === sortCol ? (sortDir === 1 ? " ▲" : " ▼") : "";
      });
    }

    thead.querySelectorAll("th").forEach((th) => {
      th.addEventListener("click", () => {
        const col = +(th as HTMLElement).dataset.col!;
        if (sortCol === col) sortDir *= -1;
        else {
          sortCol = col;
          sortDir = 1;
        }
        order.sort((a, b) => {
          const x = texts[a]![col] || "";
          const y = texts[b]![col] || "";
          return x.localeCompare(y, undefined, { numeric: true }) * sortDir;
        });
        draw();
      });
    });
    filterEl.addEventListener("input", draw);
    draw();
  }

  document.querySelectorAll<HTMLTableElement>("table.data").forEach(enhanceTable);
</script>
